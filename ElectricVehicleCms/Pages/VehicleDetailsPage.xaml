
<Page x:Class="ElectricVehicleCms.Pages.VehicleDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{StaticResource SurfaceBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Text="Vehicle details" />

            <Button DockPanel.Dock="Right"
                    Width="100"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="BackButton_Click"
                    ToolTip="Go back"
                    Content="Back" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="22"
                Background="{StaticResource CardBrush}"
                BorderBrush="#D5DEE5"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Padding="8"
                            Height="220"
                            BorderBrush="#D5DEE5"
                            BorderThickness="1"
                            CornerRadius="16"
                            Background="#FAFCFD">
                        <Image x:Name="VehicleImage"
                               Stretch="Uniform" />
                    </Border>

                    <TextBlock x:Name="VehicleNameTextBlock"
                               Margin="0,18,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" />

                    <TextBlock x:Name="ManufacturerTextBlock"
                               Margin="0,10,0,0"
                               FontSize="16"
                               Foreground="{StaticResource TextBrush}" />

                    <TextBlock x:Name="RangeTextBlock"
                               Margin="0,8,0,0"
                               FontSize="16"
                               Foreground="{StaticResource TextBrush}" />

                    <TextBlock x:Name="DateAddedTextBlock"
                               Margin="0,8,0,0"
                               FontSize="16"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="Detailed description" />

                    <FlowDocumentScrollViewer x:Name="DescriptionViewer"
                                              Margin="0,12,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              IsToolBarVisible="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
